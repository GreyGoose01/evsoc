{
 "name": "evsoc_bmw_sme",
 "description": "BMW i3 and Mini Cooper SE, experimental for BMW F-series PHEVs: battery control unit SME (0x07, 6F1 -> 607, extended addressing). 22DDBC gives the physical SoC plus the limits for 0 % and 100 % display, 226335 the SoH, 22DFA0 the cell capacity (min/max/mean in Ah). Over ELM only with adapters that support ATCEA; alternatively ENET.",
 "source": "ABRP Mini/MiniCooperSE.json, OBDb BMW-i3, OVMS mailing list, OBDb BMW (22DFA0, captures i3 2015-2021)",
 "license": "Apache-2.0 / CC-BY-SA-4.0 (facts)",
 "verified": "Mini Cooper SE, i3",
 "platform": "BMW i3",
 "vehicles": [
  {
   "make": "BMW",
   "model": "i3 / i3s",
   "years": [
    2013,
    2022
   ]
  },
  {
   "make": "Mini",
   "model": "Cooper SE",
   "years": [
    2020,
    2024
   ]
  },
  {
   "make": "BMW",
   "model": "225xe / 330e / 530e / X1 25e / X5 40e (F series, experimental)",
   "years": [
    2015,
    2019
   ]
  }
 ],
 "init": [
  "ATAL"
 ],
 "steps": [
  {
   "id": "ddbc",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "22DDBC"
  },
  {
   "id": "dd68",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "22DD68"
  },
  {
   "id": "dd69",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "22DD69"
  },
  {
   "id": "6335",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "226335"
  },
  {
   "id": "ddc0",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "22DDC0"
  },
  {
   "id": "dfa0",
   "at": [
    "ATPBE101",
    "ATSPB",
    "ATAT0",
    "ATST0F",
    "ATSH6F1",
    "ATCRA607",
    "ATCEA07",
    "ATFCSH6F1",
    "ATFCSD07300800",
    "ATFCSM1"
   ],
   "request": "22DFA0"
  }
 ],
 "fields": {
  "soc": {
   "step": "ddbc",
   "decode": {
    "type": "equation",
    "expr": "INT16(A,B)*0.1"
   },
   "min": 1,
   "max": 100,
   "unit": "%"
  },
  "soc_display": {
   "step": "ddbc",
   "decode": {
    "type": "equation",
    "expr": "(INT16(A,B)-INT16(E,F))*100/(INT16(C,D)-INT16(E,F))"
   },
   "min": -5,
   "max": 105,
   "unit": "%"
  },
  "soc_display_max": {
   "step": "ddbc",
   "decode": {
    "type": "equation",
    "expr": "INT16(C,D)*0.1"
   },
   "min": 50,
   "max": 100,
   "unit": "%"
  },
  "soc_display_min": {
   "step": "ddbc",
   "decode": {
    "type": "equation",
    "expr": "INT16(E,F)*0.1"
   },
   "min": 1,
   "max": 50,
   "unit": "%"
  },
  "voltage": {
   "step": "dd68",
   "decode": {
    "type": "equation",
    "expr": "INT16(A,B)*0.01"
   },
   "min": 200,
   "max": 450,
   "unit": "V"
  },
  "current": {
   "step": "dd69",
   "decode": {
    "type": "equation",
    "expr": "-0.01*((signed(C)*256)+D)"
   },
   "min": -300,
   "max": 300,
   "unit": "A"
  },
  "soh": {
   "step": "6335",
   "decode": {
    "type": "equation",
    "expr": "D"
   },
   "min": 0,
   "max": 100,
   "unit": "%"
  },
  "batt_temp": {
   "step": "ddc0",
   "decode": {
    "type": "equation",
    "expr": "(signed(E)*256+F)/100"
   },
   "min": -40,
   "max": 80,
   "unit": "°C"
  },
  "cell_capacity_min": {
   "step": "dfa0",
   "decode": {
    "type": "equation",
    "expr": "INT16(A,B)/100"
   },
   "min": 10,
   "max": 200,
   "unit": "Ah"
  },
  "cell_capacity_max": {
   "step": "dfa0",
   "decode": {
    "type": "equation",
    "expr": "INT16(C,D)/100"
   },
   "min": 10,
   "max": 200,
   "unit": "Ah"
  },
  "cell_capacity_avg": {
   "step": "dfa0",
   "decode": {
    "type": "equation",
    "expr": "INT16(E,F)/100"
   },
   "min": 10,
   "max": 200,
   "unit": "Ah"
  }
 }
}
