 "fields": {
  "soc_display": {
   "step": "soc_display",
   "decode": {
    "type": "equation",
    "expr": "A"
   },
   "min": 0,
   "max": 100,
   "unit": "%"
  },
  "soc_bms": {
   "step": "soc_bms",
   "decode": {
    "type": "equation",
    "expr": "A*100/255"
   },
   "min": 0,
   "max": 100,
   "unit": "%"
  },
  "capacity": {
   "step": "capacity",
   "decode": {
    "type": "equation",
    "expr": "(INT16(A,B)+INT16(C,D)+INT16(E,F)+INT16(G,H)+INT16(I,J)+INT16(K,L)+INT16(M,N)+INT16(O,P))/800"
   },
   "min": 100,
   "max": 230,
   "unit": "Ah",
   "label": "Full charge capacity"
  },
  "soh": {
   "step": "capacity",
   "decode": {
    "type": "equation",
    "expr": "(INT16(A,B)+INT16(C,D)+INT16(E,F)+INT16(G,H)+INT16(I,J)+INT16(K,L)+INT16(M,N)+INT16(O,P))/800*100/201.1"
   },
   "min": 50,
   "max": 110,
   "unit": "%"
  }
 }
